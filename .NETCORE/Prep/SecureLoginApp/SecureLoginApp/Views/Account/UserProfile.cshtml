@model SecureLoginApp.ViewModels.UserProfileViewModel

<h2>User Profile</h2>

<div>
    <p><strong>Username:</strong> @Model.Username</p>
    <p><strong>Email:</strong> @Model.Email</p>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">
        @Model.Message
    </div>
}
