@using FeedbackPortal.Helpers
@model FeedbackPortal.Models.Feedback
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, FeedbackPortal

<h2>Customer Feedback Form</h2>

<form asp-action="Index" method="post">
    <div>
        <label>Name</label>
        @Html.StyledTextBox("Name", "Enter your name")
    </div>

    <div>
        <label>Email</label>
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder="Enter email" })
    </div>

    <div>
        <label>Rating</label>
        <star-rating max="5"></star-rating>
        @Html.DropDownListFor(m => m.Rating,
            new SelectList(new[] {1,2,3,4,5}),
            "-- Select Rating --",
            new { @class="form-control" })
    </div>

    <div>
        <label>Comments</label>
        @Html.TextAreaFor(m => m.Comments, new { @class="form-control", placeholder="Your feedback" })
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</form>

<a asp-controller="Feedback" asp-action="Submitted">View Submitted Feedback</a>
